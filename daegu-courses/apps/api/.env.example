DATABASE_URL=postgres://postgres:postgres@localhost:5432/daegu_courses

# --- Auth ---
# At least 32 chars; openssl rand -base64 48
JWT_SECRET=
# Optional TTL overrides
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=2592000

# Kakao OIDC — https://developers.kakao.com/console/app
KAKAO_REST_API_KEY=
# Optional; required only when you enabled "client secret" in Kakao console.
# KAKAO_CLIENT_SECRET=

# --- Crawler (optional overrides) ---
# Defaults match the production CMS observed in CNDAjax.js (prod env):
#   token:    https://library.daegu.go.kr/token.do
#   API base: https://library-ssl.daegu.go.kr/apply/api/v1/cul/apply
# DAEGU_LIBRARY_TOKEN_URL=
# DAEGU_LIBRARY_API_BASE=

# --- HTTP ---
# PORT=3000
# CORS_ORIGINS=http://localhost:3001

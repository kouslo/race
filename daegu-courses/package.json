{
  "name": "daegu-courses",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "api": "pnpm --filter @daegu-courses/api api",
    "api:dev": "pnpm --filter @daegu-courses/api api:dev",
    "crawl:all": "pnpm --filter @daegu-courses/api crawl:all",
    "notify:dispatch": "pnpm --filter @daegu-courses/api notify:dispatch",
    "db:push": "pnpm --filter @daegu-courses/api db:push",
    "db:seed": "pnpm --filter @daegu-courses/api db:seed",
    "db:studio": "pnpm --filter @daegu-courses/api db:studio",
    "web:dev": "pnpm --filter @daegu-courses/web dev",
    "mobile:dev": "pnpm --filter @daegu-courses/mobile start"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
